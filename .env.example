UIB_DATABASE_URL=postgresql+asyncpg://uib:uib@localhost:5432/uib
UIB_LLM_PROVIDER=openai
# Leave empty to use the provider default (gpt-4o for openai).
UIB_LLM_MODEL=
# The screenshot verifier. Empty uses UIB_LLM_MODEL. Prefer gpt-4o over gpt-4o-mini here: mini
# bills image tiles ~30x heavier, which costs more and trips tokens-per-minute limits.
UIB_VERIFIER_MODEL=
UIB_MAX_PARALLEL_SCREENS=2
UIB_EMBEDDING_PROVIDER=openai
UIB_EMBEDDING_MODEL=text-embedding-3-small
UIB_EMBEDDING_DIMENSIONS=1536
UIB_MAX_DESIGN_ITERATIONS=3
UIB_RETRIEVAL_BUDGET_TOKENS=1500
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
